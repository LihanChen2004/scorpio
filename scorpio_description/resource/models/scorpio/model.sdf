		<joint name="rplidar_a2_joint" type="fixed">
			<pose relative_to="base_link">-0.04 0.0 0.24 0 0 0</pose>
			<parent>base_link</parent>
			<child>rplidar_a2</child>
		</joint>
		<link name="rplidar_a2">
			<pose relative_to="rplidar_a2_joint">0 0 0 0 0 0</pose>
			<inertial>
				<pose>0 0 0.02 0 0 0</pose>
				<mass>0.005</mass>
				<inertia>
					<ixx>2.6666666666666664e-06</ixx>
					<ixy>0</ixy>
					<ixz>0</ixz>
					<iyy>2.6666666666666664e-06</iyy>
					<iyz>0</iyz>
					<izz>4.000000000000001e-06</izz>
				</inertia>
			</inertial>
			<visual name="visual">
				<geometry>
					<mesh>
						<uri>model://rplidar_a2/meshes/rplidar_a2.dae</uri>
					</mesh>
				</geometry>
			</visual>
			<collision name="collision">
				<pose>0 0 0.02 0 0 0</pose>
				<geometry>
					<cylinder>
						<radius>0.04</radius>
						<length>0.04</length>
					</cylinder>
				</geometry>
			</collision>
			<sensor name="rplidar_a2" type="gpu_lidar">
				<ignition_frame_id>rplidar_a2</ignition_frame_id>
				<pose>0 0 0.03 0 0 0</pose>
				<always_on>true</always_on>
				<visualize>false</visualize>
				<update_rate>20.0</update_rate>
				<ray>
					<scan>
						<horizontal>
							<samples>1875.0</samples>
							<resolution>1.0</resolution>
							<min_angle>0</min_angle>
							<max_angle>6.28000020980835</max_angle>
						</horizontal>
					</scan>
					<range>
						<min>0.15</min>
						<max>12.0</max>
					</range>
				</ray>
				<noise>
					<type>gaussian</type>
					<mean>0.0</mean>
					<stddev>0.01</stddev>
				</noise>
			</sensor>
		</link>
		<!-- Ackermann steering plugin -->
		<plugin filename="ignition-gazebo-ackermann-steering-system" name="ignition::gazebo::systems::AckermannSteering">
			<left_joint>left_rear_wheel_joint</left_joint>
			<left_joint>left_front_wheel_joint</left_joint>
			<right_joint>right_rear_wheel_joint</right_joint>
			<right_joint>right_front_wheel_joint</right_joint>
			<left_steering_joint>left_front_steering_joint</left_steering_joint>
			<right_steering_joint>right_front_steering_joint</right_steering_joint>
			<!-- 车辆几何参数 -->
			<wheel_separation>0.1856</wheel_separation>
			<!-- 左右轮间距 -->
			<kingpin_width>0.18</kingpin_width>
			<!-- 转向销间距，通常略小于轮间距 -->
			<wheel_base>0.315</wheel_base>
			<!-- 前后轮轴距 -->
			<wheel_radius>0.052</wheel_radius>
			<!-- 轮子半径 -->
			<!-- 转向限制 (弧度) -->
			<steering_limit>-0.5235987755982988</steering_limit>
			<!-- 30度转向限制 -->
			<!-- 速度和加速度限制 -->
			<min_velocity>-2.0</min_velocity>
			<max_velocity>2.0</max_velocity>
			<min_acceleration>-6.0</min_acceleration>
			<max_acceleration>6.0</max_acceleration>
			<!-- 坐标系设置 -->
			<frame_id>odom</frame_id>
			<child_frame_id>base_link</child_frame_id>
			<!-- 里程计发布频率 -->
			<odom_publish_frequency>20</odom_publish_frequency>
		</plugin>
		<!-- pose publisher plugin -->
		<plugin filename="ignition-gazebo-pose-publisher-system" name="ignition::gazebo::systems::PosePublisher">
			<publish_link_pose>true</publish_link_pose>
			<publish_collision_pose>false</publish_collision_pose>
			<publish_visual_pose>false</publish_visual_pose>
			<publish_sensor_pose>false</publish_sensor_pose>
			<publish_nested_model_pose>true</publish_nested_model_pose>
			<update_frequency>20</update_frequency>
		</plugin>
		<!-- joint state publisher plugin -->
		<plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher">
    </plugin>
	</model>
</sdf>

