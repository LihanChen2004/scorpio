        <pose>0 0 0 1.5707 0 0</pose>
        <xmacro_block name="inertia_cylinder" m="0.2" r="0.0525" l="0.0426" />
      </inertial>
      <visual name="${prefix}_wheel_visual">
        <geometry>
          <mesh>
            <scale>0.001 0.001 0.001</scale>
            <uri>model://scorpio/meshes/right_wheel.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1</ambient>
          <diffuse>0.05 0.05 0.05</diffuse>
          <specular>0.6 0.6 0.6</specular>
        </material>
      </visual>
      <collision name="${prefix}_wheel_collision">
        <pose>0 0 0 1.5707 0 0</pose>
        <xmacro_block name="geometry_cylinder" r="0.054" l="0.04" />
        <surface>
          <friction>
            <ode>
              <mu>0.2</mu>
              <mu2>0.2</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
  </xmacro_define_block>
</sdf>