<?xml version="1.0"?>
<sdf version="1.7">
  <!-- macro definition: chassis_wheel -->
  <xmacro_define_block name="chassis_wheel_l" params="prefix parent pose">
    <joint name="${prefix}_wheel_joint" type="revolute">
      <pose relative_to="${parent}">${pose}</pose>
      <parent>${parent}</parent>
      <child>${prefix}_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
          <effort>1e+10</effort>
          <velocity>1e+10</velocity>
        </limit>
      </axis>
    </joint>
    <link name="${prefix}_wheel">
      <pose relative_to="${prefix}_wheel_joint">0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 1.5707 0 0</pose>
        <xmacro_block name="inertia_cylinder" m="0.2" r="0.0525" l="0.0426" />
      </inertial>
      <visual name="${prefix}_wheel_visual">
        <geometry>
          <mesh>
            <scale>0.001 0.001 0.001</scale>
            <uri>model://scorpio/meshes/left_wheel.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1</ambient>
          <diffuse>0.05 0.05 0.05</diffuse>
          <specular>0.6 0.6 0.6</specular>
        </material>
      </visual>
      <collision name="${prefix}_wheel_collision">
        <pose>0 0 0 1.5707 0 0</pose>
        <xmacro_block name="geometry_cylinder" r="0.054" l="0.04" />
        <surface>
          <friction>
            <ode>
              <mu>0.2</mu>
              <mu2>0.2</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
  </xmacro_define_block>

  <xmacro_define_block name="chassis_wheel_r" params="prefix parent pose">
    <joint name="${prefix}_wheel_joint" type="revolute">
      <pose relative_to="${parent}">${pose}</pose>
